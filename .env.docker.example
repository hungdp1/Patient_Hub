# ============================================================
#  Patient Hub - Docker deployment environment
#  Copy this file to ".env" (same folder as docker-compose.yml)
#  and replace every value below with your own secrets.
#    cp .env.docker.example .env
# ============================================================

# --- PostgreSQL (database container) ---
POSTGRES_USER=patient_user
POSTGRES_PASSWORD=change-this-strong-db-password
POSTGRES_DB=patient_hub

# --- Backend secrets ---
# Long random string. Generate one with:  openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRATION=7d

# MUST be exactly 32 characters long (AES-256 key for credit-card encryption)
CREDIT_CARD_ENCRYPTION_KEY=12345678901234567890123456789012

# Google Gemini API key (optional - AI chat falls back to a safe placeholder
# if left empty). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Public HTTP port the site is served on ---
# 80 = http://your-vps-ip/    (use 8080 if port 80 is taken)
HTTP_PORT=80
